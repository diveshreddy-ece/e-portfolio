  <!-- VLSI -->
  <section id="vlsi" class="py-24 sm:py-32 border-t border-navy-900/10 bg-gradient-to-b from-vlsi-50/40 to-transparent" data-explore-section hidden>
    <div class="max-w-7xl mx-auto px-5 sm:px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 reveal">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-vlsi-600 font-mono bg-vlsi-50 px-3 py-1 rounded-md border border-vlsi-100">VLSI &amp; Digital Design</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-navy-900 tracking-tight mt-3">From RTL intent to working hardware.</h2>
        </div>
        <p class="text-slate-600 text-sm max-w-md">RTL design, functional verification, and implementation flow — the discipline behind reliable digital hardware.</p>
      </div>

      <!-- Flow diagram -->
      <div class="reveal mb-16 overflow-x-auto">
        <svg viewBox="0 0 980 120" class="w-full min-w-[640px] h-28" id="vlsi-flow" fill="none">
          <line x1="90" y1="60" x2="890" y2="60" stroke="#bae6fd" stroke-width="2"/>
          <line id="flow-line" class="flow-line" x1="90" y1="60" x2="890" y2="60" stroke="#0284C7" stroke-width="2"/>
          <g font-family="JetBrains Mono, monospace" font-size="12" fill="#0C2340">
            <circle cx="90" cy="60" r="7" fill="#0EA5E9"/>
            <text x="90" y="98" text-anchor="middle">RTL Design</text>
            <circle cx="357" cy="60" r="7" fill="#0EA5E9"/>
            <text x="357" y="98" text-anchor="middle">Verification</text>
            <circle cx="624" cy="60" r="7" fill="#0EA5E9"/>
            <text x="624" y="98" text-anchor="middle">Synthesis</text>
            <circle cx="890" cy="60" r="7" fill="#0EA5E9"/>
            <text x="890" y="98" text-anchor="middle">FPGA / Implementation</text>
          </g>
        </svg>
      </div>

      <!-- Discipline cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        <article class="card glow-cyan p-7 space-y-3 reveal">
          <div class="w-11 h-11 rounded-xl bg-vlsi-50 text-vlsi-600 flex items-center justify-center"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
          <h3 class="font-bold text-navy-900">RTL Design</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Synthesizable Verilog / SystemVerilog built around clear module boundaries and readable state machines.</p>
        </article>
        <article class="card glow-cyan p-7 space-y-3 reveal" style="transition-delay:.05s">
          <div class="w-11 h-11 rounded-xl bg-vlsi-50 text-vlsi-600 flex items-center justify-center"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 3c-3.183 0-6.073 1.24-8.22 3.263M3 6l1.5 4.5L9 9m12 9l-1.5-4.5L15 15"/></svg></div>
          <h3 class="font-bold text-navy-900">Verification</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Testbenches and UVM environments that catch corner cases early, with coverage-driven closure.</p>
        </article>
        <article class="card glow-cyan p-7 space-y-3 reveal" style="transition-delay:.1s">
          <div class="w-11 h-11 rounded-xl bg-vlsi-50 text-vlsi-600 flex items-center justify-center"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v18m-6-6l6 6 6-6M5 7h14"/></svg></div>
          <h3 class="font-bold text-navy-900">Synthesis &amp; FPGA</h3>
          <p class="text-sm text-slate-600 leading-relaxed">Taking verified RTL through synthesis and onto FPGA, with timing and resource use as real constraints.</p>
        </article>
      </div>

      <!-- Projects -->
      <div id="vlsi-projects" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>
      <p class="text-xs text-slate-400 mt-6 font-mono">Waveform captures, RTL diagrams, and board photos to be added per project.</p>
    </div>
  </section>

