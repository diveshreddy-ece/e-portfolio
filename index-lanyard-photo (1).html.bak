<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Divesh Reddy | Engineer · Creator · Builder</title>
<meta name="description" content="Divesh Reddy — Electronics & Communication Engineering student exploring RTL design, VLSI, embedded systems, leadership and visual storytelling.">
<meta name="theme-color" content="#07111f">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['Inter', 'sans-serif'],
          mono: ['JetBrains Mono', 'monospace'],
        },
        colors: {
          navy: { DEFAULT: '#0C2340', 950: '#070f1c', 900: '#0C2340', 800: '#123057' },
          vlsi: { 50:'#eefaff',100:'#d9f2ff',300:'#7fdcff',400:'#38c6f0',500:'#0EA5E9',600:'#0284C7',700:'#0369A1' },
          lead: { 50:'#f6f3ff',100:'#ede6fe',300:'#c4aef8',400:'#a37ef0',500:'#7C3AED',600:'#6D28D9',700:'#5B21B6' },
          vid:  { 50:'#fef3fb',100:'#fce3f7',300:'#f3a6e3',400:'#e35fc9',500:'#C026D3',600:'#A21CAF',700:'#86198F' },
        }
      }
    }
  }
</script>
<style>
  :root{ --nav-h: 84px; }
  html{ scroll-padding-top: 90px; }
  body{
    font-family:'Inter',sans-serif;
    background-color:#f8fafc;
    color:#1e293b;
    overflow-x:hidden;
  }
  .font-mono{ font-family:'JetBrains Mono', monospace; }

  .grid-field{
    background-image:
      linear-gradient(to right, rgba(12,35,64,0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(12,35,64,0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse 65% 55% at 50% 0%, black 40%, transparent 85%);
            mask-image: radial-gradient(ellipse 65% 55% at 50% 0%, black 40%, transparent 85%);
  }

  .card{
    background:#fff;
    border:1px solid rgba(12,35,64,0.08);
    box-shadow: 0 1px 2px rgba(12,35,64,0.04);
    border-radius: 24px;
    transition: transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s cubic-bezier(.16,1,.3,1), border-color .35s ease;
  }
  .card:hover{ transform: translateY(-4px); box-shadow: 0 20px 40px -18px rgba(12,35,64,0.16); }

  .reveal{ opacity:0; transform: translateY(22px); transition: opacity .6s cubic-bezier(.16,1,.3,1), transform .6s cubic-bezier(.16,1,.3,1); }
  .reveal.in-view{ opacity:1; transform:none; }
  .reveal-stagger > * { transition-delay: calc(var(--i,0) * 70ms); }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration: 0.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; scroll-behavior:auto !important; }
    .reveal{ opacity:1; transform:none; }
  }

  #scroll-progress{ transform-origin: left; transform: scaleX(0); }

  .nav-link{ position:relative; }
  .nav-link .dot{ width:5px; height:5px; border-radius:999px; display:inline-block; margin-right:6px; opacity:0; transform:scale(.4); transition: opacity .25s ease, transform .25s ease; }
  .nav-link.active .dot{ opacity:1; transform:scale(1); }
  .nav-link.active{ color:#0f172a; font-weight:600; }

  .flow-line{ stroke-dasharray: 6 320; stroke-dashoffset: 0; transition: stroke-dasharray 1.1s cubic-bezier(.16,1,.3,1); }
  .flow-line.draw{ stroke-dasharray: 320 0; }

  .glow-cyan:hover{ box-shadow: 0 0 0 1px rgba(14,165,233,.35), 0 18px 40px -14px rgba(14,165,233,.35); }
  .glow-violet:hover{ box-shadow: 0 0 0 1px rgba(124,58,237,.32), 0 18px 40px -14px rgba(124,58,237,.32); }
  .glow-fuchsia:hover{ box-shadow: 0 0 0 1px rgba(192,38,211,.32), 0 18px 40px -14px rgba(192,38,211,.32); }

  ::selection{ background:#0EA5E9; color:white; }

  dialog#project-modal{ border:none; padding:0; background:transparent; max-width:none; width:100%; height:100%; }
  dialog#project-modal::backdrop{ background:rgba(7,15,28,0.6); backdrop-filter: blur(4px); }

  /* Modal cursor fix: ensure native cursor works in top-layer dialogs */
dialog:modal, dialog[open], dialog:modal *, dialog[open] * { cursor: auto !important; }
dialog:modal button, dialog[open] button, dialog:modal a, dialog[open] a, dialog:modal [role="button"], dialog[open] [role="button"] { cursor: pointer !important; }
body.modal-open #custom-cursor, body.explore-dialog-active #custom-cursor { display: none !important; }
body.modal-open, body.explore-dialog-active { cursor: auto !important; }
  /* Custom section-aware cursor — desktop with a fine pointer only. */
  body.custom-cursor-active{ cursor:none; }
  body.custom-cursor-active a, body.custom-cursor-active button, body.custom-cursor-active [role="button"]{ cursor:none; }

  #custom-cursor{
    position:fixed; top:0; left:0; z-index:9999;
    pointer-events:none;
    transform:translate(-50%,-50%);
    display:flex; align-items:center; justify-content:center;
    opacity:0; transition: opacity .2s ease, width .25s cubic-bezier(.16,1,.3,1), height .25s cubic-bezier(.16,1,.3,1);
    width:22px; height:22px;
  }
  #custom-cursor.is-visible{ opacity:1; }
  #custom-cursor .ring{
    position:absolute; inset:0; border-radius:999px; border:1.5px solid rgba(12,35,64,.55);
    transition: border-color .25s ease, background .25s ease, transform .18s ease;
  }
  #custom-cursor.is-hover .ring{ transform:scale(1.35); }
  #custom-cursor .glyph{
    position:absolute; display:flex; align-items:center; justify-content:center;
    opacity:0; transform:scale(.5); transition: opacity .22s ease, transform .22s cubic-bezier(.34,1.56,.64,1);
  }
  #custom-cursor[data-mode="vlsi"]{ width:34px; height:34px; }
  #custom-cursor[data-mode="vlsi"] .ring{ border-color:#0EA5E9; background:rgba(14,165,233,.12); box-shadow:0 0 16px rgba(14,165,233,.35); }
  #custom-cursor[data-mode="vlsi"] .glyph--vlsi{ opacity:1; transform:scale(1); }

  #custom-cursor[data-mode="leadership"]{ width:34px; height:34px; }
  #custom-cursor[data-mode="leadership"] .ring{ border-color:#7C3AED; background:rgba(124,58,237,.12); box-shadow:0 0 16px rgba(124,58,237,.35); }
  #custom-cursor[data-mode="leadership"] .glyph--leadership{ opacity:1; transform:scale(1); }

  #custom-cursor[data-mode="video"]{ width:34px; height:34px; }
  #custom-cursor[data-mode="video"] .ring{ border-color:#C026D3; background:rgba(192,38,211,.12); box-shadow:0 0 16px rgba(192,38,211,.35); }
  #custom-cursor[data-mode="video"] .glyph--video{ opacity:1; transform:scale(1); }

  @media (prefers-reduced-motion: reduce), (hover:none), (pointer:coarse){
    #custom-cursor{ display:none !important; }
    body.custom-cursor-active{ cursor:auto !important; }
  }

  .skip-link{ position:absolute; left:-9999px; top:0; z-index:100; background:#0C2340; color:#fff; padding:.75rem 1.25rem; border-radius:0 0 10px 0; }
  .skip-link:focus{ left:0; }

  a:focus-visible, button:focus-visible, [tabindex]:focus-visible{
    outline:2px solid #0EA5E9; outline-offset:3px; border-radius:6px;
  }

/* Explore Me · FolderFloat-inspired category chooser */
.explore-me-button{background:linear-gradient(110deg,#0f2340,#2455a4 55%,#7c3aed);border:1px solid rgba(255,255,255,.2);position:relative;overflow:hidden;transition:transform .25s,box-shadow .25s}
.explore-me-button:before{content:"";position:absolute;inset:0;transform:translateX(-120%);background:linear-gradient(105deg,transparent,rgba(255,255,255,.24),transparent);transition:transform .65s}
.explore-me-button:hover{transform:translateY(-3px);box-shadow:0 18px 40px rgba(37,75,150,.28)}.explore-me-button:hover:before{transform:translateX(120%)}
.explore-me-arrow{font-size:18px;transition:transform .25s}.explore-me-button:hover .explore-me-arrow{transform:translate(3px,-3px)}
#explore-me-dialog{border:0;padding:0;background:transparent;max-width:none;max-height:none;overflow:visible;color:inherit}
#explore-me-dialog::backdrop{background:rgba(3,9,22,.78);backdrop-filter:blur(12px);animation:explore-backdrop-in .25s ease both}
.explore-dialog-shell{width:min(92vw,720px);min-height:440px;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:54px 28px 34px;border:1px solid rgba(148,163,184,.22);border-radius:30px;background:radial-gradient(ellipse at 50% 0%,rgba(59,130,246,.2),transparent 55%),linear-gradient(145deg,#0b172b,#101b31 60%,#17132b);box-shadow:0 35px 100px rgba(0,0,0,.55);overflow:hidden}
.explore-dialog-shell:before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(148,163,184,.22) .7px,transparent .7px);background-size:22px 22px;opacity:.22;mask-image:linear-gradient(to bottom,black,transparent 85%);pointer-events:none}
.explore-close{position:absolute;top:18px;right:18px;width:38px;height:38px;border-radius:50%;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:white;font-size:22px;z-index:4;cursor:pointer;transition:background .2s,transform .2s}.explore-close:hover{background:rgba(255,255,255,.15);transform:rotate(90deg)}
.explore-eyebrow{position:relative;color:#93c5fd;font:600 10px/1.4 ui-monospace,monospace;letter-spacing:.2em;text-transform:uppercase}
.explore-heading{position:relative;margin:12px 0 8px;color:#f8fafc;font-size:clamp(25px,5vw,38px);font-weight:800;letter-spacing:-.04em;text-align:center}
.explore-subheading{position:relative;color:#aab8cc;font-size:14px;text-align:center;max-width:430px;line-height:1.6}
.explore-folder-stage{position:relative;width:min(100%,570px);height:230px;margin-top:18px;display:flex;justify-content:center;align-items:flex-end}
.explore-folder{position:relative;width:214px;height:142px;border-radius:17px 17px 19px 19px;background:linear-gradient(145deg,#244b7d,#162e51);box-shadow:0 24px 50px rgba(0,0,0,.4),inset 0 1px rgba(255,255,255,.16);transform:perspective(700px) rotateX(5deg);z-index:2}
.explore-folder:before{content:"";position:absolute;left:0;top:-13px;width:88px;height:23px;border-radius:12px 12px 0 0;background:#244b7d}
.explore-folder-front{position:absolute;inset:29% 0 0;border-radius:13px 13px 17px 17px;background:linear-gradient(155deg,#3265a2,#1b3c67);border-top:1px solid rgba(255,255,255,.2);display:flex;flex-direction:column;align-items:center;justify-content:center;color:white;box-shadow:0 -8px 24px rgba(0,0,0,.18);transform-origin:50% 100%;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
.explore-folder-label{font-weight:700;font-size:14px;letter-spacing:.01em}.explore-folder-hint{font:10px ui-monospace,monospace;color:#bfdbfe;margin-top:5px;letter-spacing:.12em}
.explore-choice{position:absolute;left:50%;bottom:96px;z-index:3;opacity:0;pointer-events:none;transform:translate(-50%,42px) scale(.7) rotate(var(--tilt));padding:12px 17px;border:1px solid rgba(255,255,255,.16);border-radius:999px;color:#f8fafc;font-size:13px;font-weight:700;white-space:nowrap;box-shadow:0 12px 28px rgba(0,0,0,.28);transition:transform .55s cubic-bezier(.22,1.35,.36,1),opacity .25s;cursor:pointer}
.explore-choice[data-choice="vlsi"]{--tilt:-5deg;background:linear-gradient(110deg,#075985,#2563eb)}.explore-choice[data-choice="events"]{--tilt:4deg;background:linear-gradient(110deg,#6d28d9,#9333ea)}.explore-choice[data-choice="video"]{--tilt:-2deg;background:linear-gradient(110deg,#9d174d,#db2777)}
#explore-me-dialog[open] .explore-folder-front{transform:perspective(500px) rotateX(-34deg)}#explore-me-dialog[open] .explore-choice{opacity:1;pointer-events:auto}
#explore-me-dialog[open] .explore-choice[data-choice="vlsi"]{transform:translate(calc(-50% - 145px),-130px) rotate(-7deg) scale(1)}
#explore-me-dialog[open] .explore-choice[data-choice="events"]{transform:translate(calc(-50% + 5px),-172px) rotate(3deg) scale(1)}
#explore-me-dialog[open] .explore-choice[data-choice="video"]{transform:translate(calc(-50% + 155px),-128px) rotate(7deg) scale(1)}
.explore-choice:hover{filter:brightness(1.15);box-shadow:0 15px 35px rgba(0,0,0,.4)}.explore-dialog-foot{position:relative;margin-top:12px;color:#71839e;font:10px ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase}
@keyframes explore-backdrop-in{from{opacity:0}to{opacity:1}}
@media(max-width:560px){.explore-dialog-shell{min-height:410px;padding:54px 15px 25px;border-radius:24px}.explore-folder-stage{height:220px}#explore-me-dialog[open] .explore-choice[data-choice="vlsi"]{transform:translate(calc(-50% - 95px),-125px) rotate(-7deg) scale(.94)}#explore-me-dialog[open] .explore-choice[data-choice="events"]{transform:translate(-50%,-174px) rotate(2deg) scale(.94)}#explore-me-dialog[open] .explore-choice[data-choice="video"]{transform:translate(calc(-50% + 96px),-125px) rotate(7deg) scale(.94)}.explore-choice{font-size:11px;padding:11px 12px}}
@media(prefers-reduced-motion:reduce){.explore-me-button,.explore-me-arrow,.explore-folder-front,.explore-choice{transition:none!important;animation:none!important}}


/* Fix: modal lives in browser top layer, so the page-level custom cursor cannot appear above it. */
body.explore-dialog-active, body.explore-dialog-active * {cursor:auto !important}
body.explore-dialog-active #custom-cursor {display:none !important}
#explore-me-dialog, #explore-me-dialog * {cursor:default}
#explore-me-dialog button {cursor:pointer !important}
#explore-me-dialog[open] .explore-choice {z-index:5;animation:explore-float-in .7s cubic-bezier(.2,1.4,.3,1) both}
#explore-me-dialog[open] .explore-choice[data-choice="vlsi"] {animation-delay:.12s}
#explore-me-dialog[open] .explore-choice[data-choice="events"] {animation-delay:.22s}
#explore-me-dialog[open] .explore-choice[data-choice="video"] {animation-delay:.32s}
@keyframes explore-float-in {from {opacity:0;filter:blur(5px);translate:0 35px;scale:.7}to{opacity:1;filter:blur(0);translate:0 0;scale:1}}
@media(prefers-reduced-motion:reduce){#explore-me-dialog[open] .explore-choice{animation:none}}

/* Explore popup spacing + slower, calmer folder animation */
.explore-dialog-shell{min-height:510px;padding-top:58px;padding-bottom:34px}
.explore-heading{margin:14px 0 10px;line-height:1.12;max-width:620px;z-index:1}
.explore-subheading{position:relative;z-index:1;max-width:460px}
.explore-folder-stage{height:270px;margin-top:34px;flex-shrink:0}
.explore-choice{transition:transform 1.15s cubic-bezier(.22,.72,.24,1),opacity .75s ease;z-index:5}
#explore-me-dialog[open] .explore-choice[data-choice="vlsi"]{transform:translate(calc(-50% - 145px),-100px) rotate(-5deg) scale(1)}
#explore-me-dialog[open] .explore-choice[data-choice="events"]{transform:translate(calc(-50% + 5px),-135px) rotate(3deg) scale(1)}
#explore-me-dialog[open] .explore-choice[data-choice="video"]{transform:translate(calc(-50% + 155px),-98px) rotate(5deg) scale(1)}
#explore-me-dialog[open] .explore-choice[data-choice="vlsi"]{animation:explore-float-in 1.25s cubic-bezier(.22,.72,.24,1) .2s both}
#explore-me-dialog[open] .explore-choice[data-choice="events"]{animation:explore-float-in 1.25s cubic-bezier(.22,.72,.24,1) .42s both}
#explore-me-dialog[open] .explore-choice[data-choice="video"]{animation:explore-float-in 1.25s cubic-bezier(.22,.72,.24,1) .64s both}
#explore-me-dialog[open] .explore-folder-front{transition:transform 1.15s cubic-bezier(.22,.72,.24,1)}
@media(max-width:560px){
 .explore-dialog-shell{min-height:490px;padding:54px 14px 26px}
 .explore-folder-stage{height:260px;margin-top:28px}
 #explore-me-dialog[open] .explore-choice[data-choice="vlsi"]{transform:translate(calc(-50% - 91px),-105px) rotate(-5deg) scale(.92)}
 #explore-me-dialog[open] .explore-choice[data-choice="events"]{transform:translate(-50%,-139px) rotate(2deg) scale(.92)}
 #explore-me-dialog[open] .explore-choice[data-choice="video"]{transform:translate(calc(-50% + 92px),-103px) rotate(5deg) scale(.92)}
}


/* Each selected path becomes its own standalone portfolio view. */
[data-explore-section][hidden]{display:none!important}
[data-explore-section].explore-revealed{display:block!important;animation:explore-section-reveal .7s ease both}
body.explorer-mode #home,body.explorer-mode #about,body.explorer-mode #contact{display:none!important}
body.explorer-mode [data-explore-section]:not(.explore-revealed){display:none!important} body.explorer-mode #site-header{z-index:60!important}
body.explorer-mode #main-nav a[href="#home"],body.explorer-mode #main-nav a[href="#about"]{opacity:.55}
.explore-backbar{position:fixed;top:76px;left:0;right:0;z-index:70;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px clamp(20px,5vw,64px);background:rgba(7,17,31,.96);color:#f8fafc;border-bottom:1px solid rgba(148,163,184,.18)}
.explore-back-button{display:inline-flex;align-items:center;gap:9px;padding:10px 16px;border:1px solid rgba(148,163,184,.3);border-radius:999px;color:#e2e8f0;font-size:13px;font-weight:600;transition:background .2s,border-color .2s}
.explore-back-button:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.55)}
.explore-view-label{font:11px ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase;color:#94a3b8}
body.explorer-mode #vlsi,body.explorer-mode #leadership,body.explorer-mode #video{min-height:calc(100vh - 140px);padding-top:calc(6rem + 66px)!important}
@media(max-width:640px){.explore-backbar{top:68px;padding:12px 18px}.explore-view-label{font-size:9px}body.explorer-mode #vlsi,body.explorer-mode #leadership,body.explorer-mode #video{padding-top:calc(5rem + 56px)!important}}
@keyframes explore-section-reveal{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}

/* React Bits VariableProximity-inspired hero typography (vanilla JS implementation) */

.hero-proximity-title{font-family:'Roboto Flex',Inter,sans-serif;font-variation-settings:'wght' 520,'opsz' 14;font-optical-sizing:auto;letter-spacing:-.045em;}
.hero-proximity-title .vp-letter{display:inline-block;font-variation-settings:'wght' 520,'opsz' 14;transform-origin:50% 80%;will-change:font-variation-settings,transform,color;text-rendering:geometricPrecision;color:inherit;transition:color .12s linear;}
.hero-proximity-title .vp-space{display:inline-block;white-space:pre;}
@media(prefers-reduced-motion:reduce){.hero-proximity-title .vp-letter{will-change:auto}}


/* Hero proximity typography: preserve whole words and keep the headline within its column. */
.hero-proximity-title{display:block;max-width:100%;width:100%;overflow:visible;overflow-wrap:normal;word-break:normal;hyphens:none;font-size:clamp(2.65rem,4.55vw,5.4rem);line-height:1.04}
.hero-proximity-title .vp-word{display:inline-block;white-space:nowrap}
.hero-proximity-title .vp-space{display:inline-block;white-space:pre}
@media(max-width:1024px){.hero-proximity-title{font-size:clamp(2.6rem,6vw,4.5rem)}}
@media(max-width:640px){.hero-proximity-title{font-size:clamp(2.35rem,10vw,3.6rem);line-height:1.08}}


/* VLSI timeline labels: the original navy SVG fill was nearly invisible on the dark panel. */
#vlsi svg text{fill:#9cc9ed!important;font-size:12px;font-weight:600;letter-spacing:.035em}
#vlsi svg g text{fill:#9cc9ed!important}
#vlsi svg{overflow:visible}
#vlsi .timeline-label,#vlsi .process-timeline text{fill:#9cc9ed!important}
/* Keep the exit control clearly below the sticky site navigation. */
.explore-backbar{top:92px!important;min-height:58px;padding-top:12px!important;padding-bottom:12px!important;z-index:9999!important;background:rgba(5,15,29,.985)!important;box-shadow:0 8px 24px rgba(0,0,0,.22)}
body.explorer-mode #vlsi,body.explorer-mode #leadership,body.explorer-mode #video{padding-top:calc(6rem + 78px)!important}
@media(max-width:640px){
 .explore-backbar{top:72px!important;min-height:50px;padding:9px 16px!important}
 body.explorer-mode #vlsi,body.explorer-mode #leadership,body.explorer-mode #video{padding-top:calc(5rem + 66px)!important}
}


/* Explore toolbar is in the selected section's flow, so it never covers timeline rows. */
.explore-backbar{
  position:sticky!important;
  top:76px!important;
  left:auto!important;right:auto!important;
  width:100%;
  min-height:58px;
  margin:0 0 28px!important;
  padding:12px clamp(20px,5vw,64px)!important;
  z-index:80!important;
  background:rgba(7,17,31,.985)!important;
  border-top:1px solid rgba(148,163,184,.12);
  border-bottom:1px solid rgba(148,163,184,.18);
  box-shadow:0 8px 24px rgba(0,0,0,.18);
}
body.explorer-mode #vlsi,body.explorer-mode #leadership,body.explorer-mode #video{
  padding-top:2rem!important;
}
@media(max-width:640px){
 .explore-backbar{top:68px!important;min-height:50px;padding:9px 16px!important;margin-bottom:20px!important}
 body.explorer-mode #vlsi,body.explorer-mode #leadership,body.explorer-mode #video{padding-top:1.5rem!important}
}


/* One unified navigation row: Exit to hero replaces the About link while exploring. */
body.explorer-mode #main-nav a[href="#about"]{display:none!important}
#nav-inner .explore-backbar{
  position:static!important;
  display:flex!important;
  align-items:center;
  justify-content:center;
  width:auto!important;
  min-height:0!important;
  margin:0!important;
  padding:0!important;
  background:transparent!important;
  border:0!important;
  box-shadow:none!important;
  z-index:auto!important;
}
#nav-inner .explore-view-label{display:none!important}
#nav-inner .explore-back-button{
  padding:9px 16px;
  white-space:nowrap;
  border-color:rgba(148,163,184,.28);
  background:rgba(255,255,255,.045);
  color:#e2e8f0;
}
#nav-inner .explore-back-button:hover{background:rgba(255,255,255,.12)}
@media(max-width:767px){
  #nav-inner .explore-backbar{order:3}
  #nav-inner{gap:10px}
  #nav-inner .explore-back-button{padding:8px 11px;font-size:11px}
}

</style>

<style id="sora-inter-typography">
  html, body {
    font-family: 'Inter', sans-serif;
  }

  h1, h2, h3, h4, h5, h6,
  .font-display {
    font-family: 'Sora', sans-serif;
  }

  nav, button, input, textarea, select {
    font-family: 'Inter', sans-serif;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }
</style>


<style id="portfolio-redesign-v1">
  :root{color-scheme:dark;--bg:#07111f;--panel:#0d1b2d;--panel-2:#10233a;--line:rgba(148,163,184,.16);--ink:#e8f0fb;--muted:#a5b4c8;--cyan:#38bdf8;--violet:#a78bfa;--pink:#e879f9}
  html{background:var(--bg);scroll-behavior:smooth}
  body{background:radial-gradient(ellipse at 14% 5%,rgba(14,165,233,.12),transparent 32%),radial-gradient(ellipse at 88% 24%,rgba(124,58,237,.11),transparent 28%),var(--bg)!important;color:var(--ink)!important}
  body:before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.24;background-image:linear-gradient(rgba(148,163,184,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,184,.08) 1px,transparent 1px);background-size:52px 52px;mask-image:linear-gradient(to bottom,black,transparent 78%)}
  #site-header{background:rgba(7,17,31,.78)!important;border-color:var(--line)!important;backdrop-filter:blur(22px)}
  #site-header a,#site-header summary{color:#dce8f7}
  #site-header a:hover,#site-header summary:hover{color:#7dd3fc}
  #mobile-menu{background:#0b192a!important;border-color:var(--line)!important}
  #mobile-menu a{color:#dce8f7!important;border-color:var(--line)!important}
  #nav-inner{max-width:1320px}
  .grid-field{opacity:.65;background-image:linear-gradient(to right,rgba(56,189,248,.10) 1px,transparent 1px),linear-gradient(to bottom,rgba(56,189,248,.10) 1px,transparent 1px)!important}
  h1,h2,h3,h4,.font-display{color:#edf5ff!important;letter-spacing:-.035em}
  p{color:var(--muted)}
  .text-navy-900,.text-slate-800,.text-slate-700{color:#e2eefa!important}
  .text-slate-600,.text-slate-500{color:#a5b4c8!important}
  .text-slate-400{color:#8294aa!important}
  .border-navy-900\/10,.border-slate-100,.border-slate-200{border-color:var(--line)!important}
  .bg-white{background:#0d1b2d!important}
  .bg-slate-50{background:#102137!important}
  .bg-vlsi-50,.bg-lead-50,.bg-vid-50{background:rgba(14,165,233,.10)!important}
  .border-vlsi-100,.border-lead-100,.border-vid-100{border-color:rgba(56,189,248,.22)!important}
  .card{background:linear-gradient(145deg,rgba(17,37,60,.96),rgba(10,25,42,.96))!important;border:1px solid var(--line)!important;border-radius:22px;box-shadow:0 12px 35px rgba(0,0,0,.16)!important;backdrop-filter:blur(12px)}
  .card:hover{transform:translateY(-7px)!important;border-color:rgba(56,189,248,.42)!important;box-shadow:0 24px 60px rgba(0,0,0,.3),0 0 28px rgba(14,165,233,.09)!important}
  section{position:relative}
  section:not(#home):not(#video){background-color:transparent!important}
  #home{min-height:720px}
  #home h1{font-size:clamp(2.7rem,5.2vw,5.2rem);line-height:1.04;max-width:900px}
  #home h1:after{content:"";display:block;width:104px;height:4px;margin-top:24px;border-radius:9px;background:linear-gradient(90deg,var(--cyan),var(--violet),var(--pink))}
  #home .inline-flex.items-center.gap-2.text-\[11px\]{background:rgba(14,165,233,.09)!important;border-color:rgba(56,189,248,.24)!important;color:#c9eaff!important}
  #home img{filter:saturate(.9);transition:transform .7s cubic-bezier(.2,.8,.2,1),filter .7s}
  #home img:hover{transform:scale(1.035);filter:saturate(1.08)}
  #home .rounded-\[2rem\]{border-color:rgba(125,211,252,.28)!important;box-shadow:0 28px 90px rgba(0,0,0,.45),0 0 55px rgba(14,165,233,.12)!important}
  #about .card,#vlsi .card,#leadership .card{border-radius:20px}
  #vlsi{background:linear-gradient(180deg,rgba(14,165,233,.055),transparent 70%)!important}
  #leadership{background:linear-gradient(180deg,rgba(124,58,237,.055),transparent 70%)!important}
  #video{background:#050b14!important}
  .video-card{border-color:var(--line)!important;transition:transform .35s,border-color .35s,box-shadow .35s}
  .video-card:hover{transform:translateY(-6px);border-color:rgba(232,121,249,.45)!important;box-shadow:0 22px 55px rgba(0,0,0,.35)}
  video{background:#020617}
  #contact{background:radial-gradient(ellipse at center,rgba(14,165,233,.09),transparent 65%)!important}
  footer{background:#050d18!important;border-color:var(--line)!important}
  footer .border-t{border-color:var(--line)!important}
  #project-modal::backdrop{background:rgba(1,6,14,.82)!important;backdrop-filter:blur(10px)}
  #project-modal>div>div{background:#0d1b2d!important;border:1px solid var(--line)}
  #project-modal .sticky{background:rgba(13,27,45,.94)!important;border-color:var(--line)!important;backdrop-filter:blur(16px)}
  #project-modal button:hover{background:#1b314b!important}
  #back-to-top{box-shadow:0 10px 30px rgba(14,165,233,.25)}
  .reveal{transform:translateY(28px);transition:opacity .75s cubic-bezier(.16,1,.3,1),transform .75s cubic-bezier(.16,1,.3,1)}
  .glow-cyan:hover{box-shadow:0 0 0 1px rgba(56,189,248,.35),0 20px 48px rgba(14,165,233,.12)!important}
  .glow-violet:hover{box-shadow:0 0 0 1px rgba(167,139,250,.35),0 20px 48px rgba(124,58,237,.12)!important}
  .glow-fuchsia:hover{box-shadow:0 0 0 1px rgba(232,121,249,.35),0 20px 48px rgba(192,38,211,.12)!important}
  ::selection{background:#0ea5e9;color:#03101d}
  a,button{ -webkit-tap-highlight-color:transparent }
  .nav-link.active{color:#7dd3fc!important}
  .nav-link .dot{background:#38bdf8!important}
  .portfolio-kicker{display:inline-flex;align-items:center;gap:9px;color:#9bdfff;font:600 11px 'JetBrains Mono',monospace;letter-spacing:.18em;text-transform:uppercase}
  .portfolio-kicker:before{content:"";width:7px;height:7px;border-radius:50%;background:#34d399;box-shadow:0 0 14px #34d399}
  .hero-role{display:inline-block;min-width:13ch;color:#7dd3fc}
  .ambient-orb{position:absolute;width:240px;height:240px;border-radius:50%;filter:blur(75px);opacity:.15;pointer-events:none;animation:orbFloat 12s ease-in-out infinite alternate}
  @keyframes orbFloat{from{transform:translate3d(0,0,0)}to{transform:translate3d(28px,-24px,0)}}
  @media(max-width:767px){#home{min-height:auto}#home h1{font-size:clamp(2.5rem,11vw,4rem)}.card:hover{transform:translateY(-3px)!important}body:before{background-size:38px 38px}}
  /* Liquid-metal CTA treatment: CSS-native equivalent for this vanilla HTML site. */
  .liquid-metal-btn{
    --lm-radius:999px;--lm-speed:5.5s;position:relative;isolation:isolate;display:inline-flex;align-items:center;justify-content:center;gap:10px;
    min-height:48px;padding:0 22px;border:1px solid rgba(226,242,255,.42);border-radius:var(--lm-radius);overflow:hidden;
    color:#f5faff!important;text-decoration:none!important;font:600 13px 'Inter',sans-serif;letter-spacing:.01em;
    background:linear-gradient(135deg,#23374b 0%,#07111f 42%,#31465a 68%,#101b2a 100%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.26),0 8px 24px rgba(0,0,0,.25),0 0 0 1px rgba(56,189,248,.08);
    transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s,border-color .35s,filter .35s;
  }
  .liquid-metal-btn:before{content:"";position:absolute;inset:-120% -35%;z-index:-1;border-radius:inherit;opacity:.78;
    background:conic-gradient(from 0deg,transparent 0 13%,rgba(255,255,255,.08) 18%,rgba(224,247,255,.9) 23%,rgba(56,189,248,.55) 27%,transparent 34% 48%,rgba(255,255,255,.7) 54%,rgba(167,139,250,.5) 59%,transparent 66% 82%,rgba(255,255,255,.55) 89%,transparent 95%);
    filter:blur(8px);animation:liquidMetalOrbit var(--lm-speed) linear infinite;transition:opacity .35s,filter .35s;
  }
  .liquid-metal-btn:after{content:"";position:absolute;inset:1px;z-index:-1;border-radius:inherit;pointer-events:none;
    background:linear-gradient(112deg,transparent 12%,rgba(255,255,255,.02) 30%,rgba(255,255,255,.23) 44%,rgba(56,189,248,.12) 49%,transparent 62%),
      radial-gradient(ellipse at 18% 0%,rgba(255,255,255,.2),transparent 42%),linear-gradient(180deg,rgba(255,255,255,.08),transparent 55%);
    background-size:220% 100%,100% 100%,100% 100%;background-position:140% 0,0 0,0 0;animation:liquidMetalSheen 4.8s ease-in-out infinite;
  }
  .liquid-metal-btn:hover,.liquid-metal-btn:focus-visible{transform:translateY(-3px) scale(1.025);border-color:rgba(186,230,253,.9);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 14px 34px rgba(0,0,0,.36),0 0 24px rgba(56,189,248,.2),0 0 42px rgba(167,139,250,.12);filter:brightness(1.12)}
  .liquid-metal-btn:hover:before,.liquid-metal-btn:focus-visible:before{opacity:1;filter:blur(5px);animation-duration:2.4s}
  .liquid-metal-btn:active{transform:translateY(0) scale(.975);box-shadow:inset 0 3px 9px rgba(0,0,0,.45),0 3px 10px rgba(0,0,0,.22)}
  .liquid-metal-btn:focus-visible{outline:2px solid #7dd3fc;outline-offset:4px}
  .liquid-metal-btn svg{width:17px;height:17px;flex:none;filter:drop-shadow(0 1px 2px rgba(0,0,0,.4));transition:transform .35s,filter .35s}
  .liquid-metal-btn:hover svg{transform:scale(1.12) rotate(-4deg);filter:drop-shadow(0 0 6px rgba(186,230,253,.65))}
  .liquid-metal-btn__arrow{font-size:16px;line-height:1;transition:transform .35s}
  .liquid-metal-btn:hover .liquid-metal-btn__arrow{transform:translate(3px,-2px)}
  .liquid-metal-btn--nav{min-height:42px;padding:0 18px;font-size:12px}
  .liquid-metal-btn--mobile{width:100%;min-height:46px}
  .liquid-metal-btn--contact{min-width:150px;min-height:52px;padding:0 24px}
  @keyframes liquidMetalOrbit{to{transform:rotate(360deg)}}
  @keyframes liquidMetalSheen{0%,18%{background-position:140% 0,0 0,0 0}58%,100%{background-position:-120% 0,0 0,0 0}}
  @media(prefers-reduced-motion:reduce){.liquid-metal-btn:before,.liquid-metal-btn:after{animation:none!important}.liquid-metal-btn,.liquid-metal-btn svg,.liquid-metal-btn__arrow{transition:none!important}}
  @media(hover:none){.liquid-metal-btn:before{opacity:.58}.liquid-metal-btn:after{animation-duration:7s}}
  @media(max-width:767px){.liquid-metal-btn--contact{flex:1 1 140px;min-width:0;padding:0 16px}}
  @media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
</style>


<style>
  .event-gallery-wrap{margin-top:1.5rem;padding:clamp(1.25rem,3vw,2.25rem);border:1px solid rgba(148,163,184,.16);border-radius:28px;background:linear-gradient(135deg,rgba(15,23,42,.96),rgba(8,18,34,.94));color:#f8fafc;overflow:hidden}
  .event-showcase{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(260px,.85fr);gap:clamp(1.5rem,5vw,4rem);align-items:center}
  .event-photo-stage{position:relative;min-height:390px;display:grid;place-items:center;perspective:1100px}
  .event-photo-card{position:absolute;width:min(100%,440px);height:350px;border-radius:24px;overflow:hidden;background:linear-gradient(145deg,#172b43,#263e59);border:1px solid rgba(255,255,255,.16);box-shadow:0 28px 70px rgba(0,0,0,.35)}
  .event-photo-card img{width:100%;height:100%;object-fit:cover;display:block}
  .event-photo-back{opacity:.55;filter:saturate(.7);transition:transform .55s cubic-bezier(.2,.8,.2,1)}
  .event-photo-back-one{transform:translate(20px,12px) rotate(5deg) scale(.96)}
  .event-photo-back-two{transform:translate(-18px,20px) rotate(-6deg) scale(.92);opacity:.3}
  .event-photo-active{z-index:3;transform:rotate(-1.5deg);transition:opacity .25s ease,transform .55s cubic-bezier(.2,.8,.2,1)}
  .event-photo-active.is-changing{opacity:.25;transform:translateY(12px) rotate(3deg) scale(.96)}
  .event-photo-placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;background:radial-gradient(circle at 50% 35%,rgba(34,211,238,.18),transparent 38%),linear-gradient(145deg,#102238,#0b1424)}
  .event-photo-placeholder span{font-size:clamp(4rem,12vw,7rem);font-weight:800;letter-spacing:-.08em;color:rgba(103,232,249,.8)}
  .event-photo-placeholder small{font:600 10px ui-monospace,monospace;letter-spacing:.22em;color:#64748b}
  .event-photo-overlay{position:absolute;inset:auto 0 0;padding:3rem 1.4rem 1.4rem;background:linear-gradient(transparent,rgba(2,6,23,.88));display:flex;flex-direction:column;gap:.35rem}
  .event-photo-kicker{font:600 10px ui-monospace,monospace;letter-spacing:.2em;color:#67e8f9}
  .event-photo-overlay strong{font-size:1.35rem;color:white}
  .event-copy-panel{max-width:420px}
  .event-counter{font:700 12px ui-monospace,monospace;letter-spacing:.12em;color:#67e8f9;margin-bottom:1rem}.event-counter span{color:#64748b}
  .event-copy-panel h4{font-size:clamp(1.7rem,3vw,2.4rem);font-weight:750;letter-spacing:-.04em;color:#f8fafc;margin:0 0 .8rem;transition:opacity .2s,transform .2s}
  .event-copy-panel p{color:#a7b5c8;line-height:1.75;font-size:.95rem;min-height:5.2rem}
  .event-gallery-controls{display:flex;gap:.75rem;margin-top:1.5rem}
  .event-gallery-controls button{width:46px;height:46px;border-radius:50%;border:1px solid rgba(148,163,184,.35);background:rgba(30,41,59,.7);color:white;font-size:1.35rem;transition:transform .2s,background .2s,border-color .2s}
  .event-gallery-controls button:hover{transform:translateY(-3px);background:#0e7490;border-color:#67e8f9}
  .event-gallery-controls button:focus-visible{outline:2px solid #67e8f9;outline-offset:3px}
  .event-gallery-note{font:11px ui-monospace,monospace;color:#64748b;margin-top:1.2rem}
  @media(max-width:760px){.event-showcase{grid-template-columns:1fr}.event-photo-stage{min-height:330px}.event-photo-card{height:290px;width:min(88%,420px)}.event-copy-panel{max-width:none}.event-copy-panel p{min-height:0}}
  @media(prefers-reduced-motion:reduce){.event-photo-card,.event-copy-panel h4,.event-gallery-controls button{transition:none!important}}
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,300..1000&display=swap" rel="stylesheet">

<style>
  /* React Bits Lanyard hero stage */
  .lanyard-stage{
    background:#101014;
    border-radius:2px;
    overflow:hidden;
    isolation:isolate;
    box-shadow:0 28px 80px rgba(2,6,23,.18);
  }
  .lanyard-root,.lanyard{position:relative;width:100%;height:100%;overflow:hidden}
  .lanyard-fallback{position:absolute;inset:18% 12% 10%;width:76%;height:72%;object-fit:cover;object-position:center 28%;filter:grayscale(1) contrast(1.06);border-radius:18px;z-index:3;background:#f8fafc}
  .lanyard-ready .lanyard-fallback{display:none}
  .lanyard-canvas{position:relative;z-index:1;display:block;width:100%;height:100%;touch-action:none}
  .lanyard-hint{
    position:absolute;left:0;right:0;bottom:16px;text-align:center;
    color:rgba(226,232,240,.72);font:500 12px/1.4 'Inter',sans-serif;
    letter-spacing:.14em;pointer-events:none;z-index:2;
  }
  @media(max-width:1023px){
    .lanyard-stage{max-width:430px;height:570px}
  }
  @media(max-width:640px){
    .lanyard-stage{height:530px;max-width:390px}
  }
  @media(prefers-reduced-motion:reduce){
    .lanyard-hint{letter-spacing:.08em}
  }
</style>


<style>
  /* Seamless hero integration: let the portfolio background show through. */
  #home .lanyard-stage{
    background: rgba(5, 12, 27, .12) !important;
    border: 1px solid rgba(125, 211, 252, .18);
    border-radius: 28px !important;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.025), 0 24px 70px rgba(2,6,23,.18) !important;
    isolation: isolate;
    overflow: visible !important;
    position: relative;
    max-width: 440px;
    height: 620px;
    margin-inline: auto;
  }
  #home .lanyard-stage::before{
    content:"";
    position:absolute;
    width:78%;
    height:68%;
    left:11%;
    top:18%;
    border-radius:50%;
    background: radial-gradient(ellipse, rgba(14,165,233,.19) 0%, rgba(124,58,237,.12) 42%, transparent 74%);
    filter: blur(30px);
    pointer-events:none;
    z-index:0;
  }
  #home .lanyard-root{
    position:relative;
    z-index:1;
    background:transparent !important;
    overflow:visible !important;
  }
  #home .lanyard-canvas{
    background:transparent !important;
    position:relative;
    z-index:1;
    outline:none;
  }
  #home .lanyard-hint{
    bottom:8px;
    color:rgba(203,213,225,.82);
    font-size:10px;
    letter-spacing:.18em;
    font-weight:600;
    z-index:2;
  }
  @media (min-width:1024px){
    #home .lanyard-stage{ transform: translateY(-4px); }
  }
  @media (max-width:1023px){
    #home .lanyard-stage{
      height:560px;
      max-width:400px;
      margin-top:6px;
    }
  }
  @media (max-width:640px){
    #home .lanyard-stage{
      height:510px;
      max-width:360px;
      margin-top:0;
    }
    #home .lanyard-hint{bottom:4px}
  }
  @media (prefers-reduced-motion:reduce){
    #home .lanyard-stage::before{filter:blur(18px)}
  }

  /* 3D Robot — seamless integration */
  #robot-container {
    position: relative;
    overflow: visible;
    width: 100%;
  }
  #robot-scene {
    perspective: 1000px;
    transform-style: preserve-3d;
    will-change: transform;
    width: 100%;
    height: 100%;
  }
  #spline-robot::part(logo) { display: none !important; opacity: 0 !important; }
  @media (min-width: 1024px) {
    #robot-container { height: 580px; }
  }
  @media (max-width: 1023px) {
    #robot-container { height: 480px; }
  }
  @media (max-width: 639px) {
    #robot-container { height: 380px; margin-top: 1.5rem; }
  }
</style>

<script type="module" src="https://unpkg.com/@splinetool/viewer@1.9.59/build/spline-viewer.js"></script>
</head>
<body class="relative min-h-screen">

<a href="#main" class="skip-link">Skip to content</a>

<!-- Scroll progress -->
<div class="fixed top-0 left-0 right-0 h-[3px] z-[60] bg-transparent">
  <div id="scroll-progress" class="h-full bg-gradient-to-r from-vlsi-500 via-lead-500 to-vid-500"></div>
</div>

<!-- Navbar -->
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-xl border-b border-navy-900/10">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 flex items-center justify-between transition-all duration-300" id="nav-inner" style="height:84px;">
    <a href="#home" class="font-bold text-navy-900 tracking-tight text-lg shrink-0">Divesh Reddy</a>

    <nav id="main-nav" class="hidden md:flex items-center gap-8 text-sm text-slate-600" aria-label="Primary">
      <a href="#about" class="nav-link hover:text-navy-900 transition" data-section="about"><span class="dot" style="background:#0C2340"></span>About</a>
    </nav>

    <div class="hidden md:flex items-center gap-3">
      <details class="relative group">
        <summary class="list-none cursor-pointer text-sm font-medium text-slate-700 hover:text-navy-900 px-3 py-2 transition">Resumes</summary>
        <div class="absolute right-0 top-full mt-2 w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
          <a href="assets/resume-rtl-design.pdf" download class="block rounded-lg px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50">RTL Design Resume</a>
          <a href="assets/resume-graphic-design.pdf" download class="block rounded-lg px-3 py-2.5 text-sm text-slate-700 hover:bg-slate-50">Graphic Design Resume</a>
        </div>
      </details>
      <a href="#contact" class="liquid-metal-btn liquid-metal-btn--nav" aria-label="Let's Talk"><span>Let's Talk</span><span class="liquid-metal-btn__arrow" aria-hidden="true">↗</span></a>
    </div>

    <button id="menu-btn" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" class="md:hidden p-2 rounded-lg border border-slate-200 text-slate-700">
      <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-navy-900/10 px-6 py-6 space-y-1">
    <a href="#vlsi" class="block py-3 text-slate-700 font-medium text-lg border-b border-slate-100">VLSI</a>
